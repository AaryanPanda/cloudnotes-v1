# CloudNotes environment configuration — EXAMPLE / placeholders only.
# Copy this file to .env and fill in real values. NEVER commit the real .env.
#
#   cp .env.example .env
#
# -----------------------------------------------------------------------------

# Flask secret key — used for sessions/signing. Generate a random one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Database connection string.
#   - PostgreSQL (deployment target):
#       postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#   - Leave unset to fall back to local SQLite (dev only).
#
# For the Codespaces setup created by deploy/setup.sh, the local PostgreSQL
# values are:
DATABASE_URL=postgresql://cloudnotes:cloudnotes_pw@localhost:5432/cloudnotes_db

# Where user-uploaded attachments are stored (defaults to ./uploads).
UPLOAD_FOLDER=uploads

# Max upload size in bytes (default 5 MB).
MAX_CONTENT_LENGTH=5242880

# Host/port for the dev server (gunicorn uses --bind, so these are for
# `python app.py` only). Bind to 0.0.0.0 so the forwarded port is reachable.
HOST=0.0.0.0
PORT=5000
