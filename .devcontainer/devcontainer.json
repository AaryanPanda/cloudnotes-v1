{
  "name": "CloudNotes Deploy (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",

  "features": {
    "ghcr.io/itsmechlark/features/postgresql:1": {
      "version": "16"
    }
  },

  // Forward the app port so you can open CloudNotes in a browser.
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {
      "label": "CloudNotes",
      "onAutoForward": "notify"
    }
  },

  // Runs once when the Codespace is created: install deps + create the
  // PostgreSQL database and user, then prepare .env from the example.
  "postCreateCommand": "bash deploy/setup.sh",

  // Runs every time the Codespace starts (including after it is stopped and
  // resumed) — this is the container equivalent of "start on boot".
  "postStartCommand": "bash deploy/start.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
